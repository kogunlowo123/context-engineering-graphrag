{
  "$defs": {
    "ClaimAssessment": {
      "properties": {
        "citations": {
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "supporting_citations": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Citations",
          "type": "array"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "claim",
        "citations",
        "verdict",
        "score",
        "supporting_citations"
      ],
      "title": "ClaimAssessment",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "supported",
        "partial",
        "contradicted",
        "unsupported"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "$id": "https://github.com/kogunlowo123/context-engineering-graphrag/schemas/groundedness.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "citation_coverage": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Citation Coverage",
      "type": "number"
    },
    "citation_precision": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Citation Precision",
      "type": "number"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimAssessment"
      },
      "title": "Claims",
      "type": "array"
    },
    "contradicted_claims": {
      "title": "Contradicted Claims",
      "type": "integer"
    },
    "groundedness": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Groundedness",
      "type": "number"
    },
    "judge": {
      "title": "Judge",
      "type": "string"
    },
    "unsupported_claims": {
      "title": "Unsupported Claims",
      "type": "integer"
    }
  },
  "required": [
    "groundedness",
    "citation_precision",
    "citation_coverage",
    "claims",
    "unsupported_claims",
    "contradicted_claims",
    "judge"
  ],
  "title": "GroundednessReport",
  "type": "object"
}
