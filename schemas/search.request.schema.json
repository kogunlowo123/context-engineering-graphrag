{
  "$defs": {
    "DataClassification": {
      "description": "Sensitivity label. Ordered from least to most restricted.",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "title": "DataClassification",
      "type": "integer"
    }
  },
  "$id": "https://github.com/kogunlowo123/context-engineering-graphrag/schemas/search.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of"
    },
    "candidates": {
      "default": 50,
      "maximum": 500,
      "minimum": 1,
      "title": "Candidates",
      "type": "integer"
    },
    "diversify": {
      "default": true,
      "title": "Diversify",
      "type": "boolean"
    },
    "document_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "type": "array",
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Ids"
    },
    "k": {
      "default": 8,
      "maximum": 100,
      "minimum": 1,
      "title": "K",
      "type": "integer"
    },
    "max_classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataClassification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Metadata",
      "type": "object"
    },
    "mmr_lambda": {
      "default": 0.7,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Mmr Lambda",
      "type": "number"
    },
    "purpose_of_use": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Purpose Of Use"
    },
    "query": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "rerank": {
      "default": true,
      "title": "Rerank",
      "type": "boolean"
    }
  },
  "required": [
    "query"
  ],
  "title": "SearchRequest",
  "type": "object"
}
